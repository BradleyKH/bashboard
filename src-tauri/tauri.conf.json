{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bashboard",
  "mainBinaryName": "bashboard",
  "version": "../package.json",
  "identifier": "dev.bashboard",
  "build": {
    "beforeDevCommand": "pnpm build:bb && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Bashboard",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0QTA4OEU1RTQxQTQ0NjIKUldSaVJCcms1WWlnRkoxbCtXTDltL0tKUzBvZmIva2hUTlZ0WFN1UDN1a1ZmRndLS3BPY2gwUTcK",
      "endpoints": ["https://github.com/BradleyKH/bashboard/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Bradley Harris",
    "copyright": "Copyright (c) 2026 Bradley Harris",
    "homepage": "https://github.com/BradleyKH/bashboard",
    "licenseFile": "../LICENSE",
    "shortDescription": "A Windows terminal for Claude Code: Git Bash panes over a live colony simulation.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
